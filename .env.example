# Copy to .env and fill in. src/lib/env.ts validates these when the app starts.
# Core values are always required. Integration secrets are required in
# production and optional in development until that feature is built.

# Database
DATABASE_URL=postgres://user:password@localhost:5432/dealerreply
# Only for `pnpm test`: a throwaway database whose name contains "test". It is wiped on every run.
TEST_DATABASE_URL=postgres://user:password@localhost:5432/dealerreply_test

# App
APP_URL=http://localhost:3000
TZ_DISPLAY=Asia/Kolkata
LOG_LEVEL=info

# Auth (Auth.js). Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
# SMTP for login links and invites, e.g. Postmark: smtp://<server-token>:<server-token>@smtp.postmarkapp.com:587
# Leave empty in development: login links are printed in the dev server's console instead.
AUTH_EMAIL_SERVER=
AUTH_EMAIL_FROM="DealerReply <no-reply@yourdomain.in>"
# Used by `pnpm db:seed` for the first operator account.
SEED_OPERATOR_EMAIL=you@example.com

# Anthropic
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-sonnet-5-5

# WhatsApp Cloud API (Meta)
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_SYSTEM_USER_TOKEN=
WA_GRAPH_API_VERSION=

# Encryption of per-dealer tokens at rest (32-byte base64)
ENCRYPTION_KEY=

# Storage (Cloudflare R2 / S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Inbound email (portal leads)
INBOUND_EMAIL_SECRET=

# Monitoring
SENTRY_DSN=
